# ── LLM + search providers ────────────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=

# ── CROO Agent Protocol (CAP) ─────────────────────────────────────────────
CROO_API_URL=https://api.croo.network
CROO_WS_URL=wss://api.croo.network/ws
CROO_SDK_KEY=croo_sk_...   # "API Key" shown ONCE when you register the agent
CROO_SERVICE_ID=            # id from the "Add Service" wizard
CROO_AGENT_ID=             # your agent's DID from registration

# ── App ───────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000   # deployed frontend origin (CORS)
# PORT is provided by the host in production (Railway/Fly/etc.)
