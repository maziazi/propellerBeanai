# ── LLM + search providers ────────────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=

# ── CROO Agent Protocol (CAP) ─────────────────────────────────────────────
CROO_API_URL=https://api.croo.network
CROO_WS_URL=wss://ws.croo.network
CROO_SDK_KEY=croo_sk_...
CROO_SERVICE_ID=            # from your Agent Store service listing
CROO_AGENT_ID=             # your agent id on the Agent Store

# ── App ───────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000   # deployed frontend origin (CORS)
# PORT is provided by the host in production (Railway/Fly/etc.)
