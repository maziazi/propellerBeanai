# ── Backend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Direct mail (magic-link login). Leave SMTP_HOST empty in dev —
# the sign-in link is logged to the server console and shown in the UI.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BeanAI <no-reply@beanai.app>

# Google OAuth (optional). Redirect URI to register in Google Cloud Console:
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Public URLs ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CROO_STORE_URL=https://agent.croo.network
