# ── Backend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google OAuth (optional). Redirect URI to register in Google Cloud Console:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Public URLs ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CROO_STORE_URL=
